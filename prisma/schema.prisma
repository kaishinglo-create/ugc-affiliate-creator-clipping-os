generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  sessions     Session[]
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id                   String                  @id @default(cuid())
  name                 String
  slug                 String                  @unique
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  memberships          Membership[]
  items                Item[]
  niches               Niche[]
  products             Product[]
  ideas                ContentIdea[]
  integrations         Integration[]
  workflows            WorkflowDefinition[]
  workflowRuns         WorkflowRun[]
  analyticsSnapshots   AnalyticsSnapshot[]
  affiliateClicks      AffiliateClick[]
  affiliateConversions AffiliateConversion[]
  affiliateLinks       AffiliateLink[]
  publishingAccounts   PublishingAccount[]
  publishingSchedules  PublishingSchedule[]
  incidents            Incident[]
  recoveryRuns         RecoveryRun[]
  improvementTasks     ImprovementTask[]
  sandboxRuns          SandboxRun[]
  creators             Creator[]
  brands               Brand[]
  campaigns            Campaign[]
  tasks                Task[]
  assets               AssetVersion[]
  experiments          Experiment[]
  insights             Insight[]
  approvals            Approval[]
  killSwitches         KillSwitch[]
  securityEvents       SecurityEvent[]
  agents               AgentDefinition[]
  agentTasks           AgentTask[]
  jobs                 Job[]
  discoveryCandidates  DiscoveryCandidate[]
  discoverySchedules   DiscoverySchedule[]
  contentPosts         ContentPost[]
  performanceSnapshots PerformanceSnapshot[]
  policies             OperationalPolicy[]
  lifecycleEvents      ContentLifecycleEvent[]
  releaseChecks        ReleaseCheck[]
  installChecks        InstallCheck[]
  departments          Department[]
  orchestrationRuns    OrchestrationRun[]
  delegationRecords    DelegationRecord[]
  apiCredentials       ApiCredential[]
  apiConnections       ApiConnection[]
  apiIntegrationEvents ApiIntegrationEvent[]
  oauthAuthorizations  OAuthAuthorization[]
  mediaSources         MediaSource[]
  researchReports      ResearchReport[]
  qualityReports       QualityReport[]
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  id          String         @id @default(cuid())
  userId      String
  workspaceId String
  role        MembershipRole @default(MEMBER)
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Item {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Agent {
  id              String     @id @default(cuid())
  key             String     @unique
  name            String
  description     String?
  status          String     @default("ACTIVE")
  toolPermissions String[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  runs            AgentRun[]

  @@index([status])
}

model AgentRun {
  id          String       @id @default(cuid())
  agentKey    String
  agent       Agent?       @relation(fields: [agentKey], references: [key])
  workspaceId String?
  userId      String?
  status      String
  input       Json
  output      Json?
  error       String?
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  auditEvents AuditEvent[]

  @@index([agentKey])
  @@index([workspaceId])
  @@index([status])
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String?
  userId      String?
  runId       String?
  run         AgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  type        String
  actor       String?
  data        Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([type])
  @@index([runId])
}

model Niche {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  description String?
  demandScore Int           @default(0)
  competition Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products    Product[]
  ideas       ContentIdea[]

  @@index([workspaceId])
}

model Product {
  id          String    @id @default(cuid())
  workspaceId String
  nicheId     String?
  name        String
  category    String?
  priceCents  Int?
  source      String?
  sourceUrl   String?
  fetchedAt   DateTime  @default(now())
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  niche       Niche?    @relation(fields: [nicheId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

model ContentIdea {
  id             String    @id @default(cuid())
  workspaceId    String
  nicheId        String?
  productId      String?
  title          String
  hook           String?
  format         String?
  targetAudience String?
  cta            String?
  keywords       String?
  score          Int       @default(0)
  status         String    @default("draft")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  niche          Niche?    @relation(fields: [nicheId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  UNAVAILABLE
  ERROR
}

model Integration {
  id          String            @id @default(cuid())
  workspaceId String
  provider    String
  status      IntegrationStatus @default(NOT_CONFIGURED)
  config      Json?
  lastError   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

enum WorkflowStatus {
  pending
  queued
  running
  waiting_for_approval
  succeeded
  failed
  cancelled
}

enum JobStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCELLED
  DEAD_LETTER
  WAITING_FOR_APPROVAL
}

enum JobType {
  WORKFLOW_RUN
  AGENT_TASK
  CONTENT_DISCOVERY
  PHASE_G_PIPELINE
}

model WorkflowDefinition {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  description String?
  steps       Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs        WorkflowRun[]

  @@index([workspaceId])
}

model WorkflowRun {
  id             String             @id @default(cuid())
  workspaceId    String
  definitionId   String
  status         WorkflowStatus     @default(pending)
  currentStep    Int                @default(0)
  input          Json?
  result         Json?
  error          String?
  idempotencyKey String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  definition     WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  steps          WorkflowStepRun[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
}

model WorkflowStepRun {
  id         String         @id @default(cuid())
  runId      String
  stepIndex  Int
  name       String
  status     WorkflowStatus @default(pending)
  input      Json?
  output     Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime       @default(now())
  run        WorkflowRun    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model Job {
  id                 String              @id @default(cuid())
  workspaceId        String
  type               JobType             @default(WORKFLOW_RUN)
  category           String?
  status             JobStatus           @default(QUEUED)
  priority           Int                 @default(0)
  payload            Json
  idempotencyKey     String?
  attempts           Int                 @default(0)
  maxAttempts        Int                 @default(3)
  lastError          String?
  leaseId            String?
  leaseOwner         String?
  leaseExpiresAt     DateTime?
  heartbeatAt        DateTime?
  runAt              DateTime            @default(now())
  startedAt          DateTime?
  finishedAt         DateTime?
  timeoutAt          DateTime?
  parentJobId        String?
  workflowRunId      String?
  agentTaskId        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orchestrationTasks OrchestrationTask[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, runAt])
  @@index([workflowRunId])
}

model AnalyticsSnapshot {
  id          String    @id @default(cuid())
  workspaceId String
  source      String
  metric      String
  value       Float
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, metric])
}

model AffiliateClick {
  id              String    @id @default(cuid())
  workspaceId     String
  contentId       String?
  offerId         String?
  linkId          String?
  postId          String?
  campaignId      String?
  creatorId       String?
  productId       String?
  platform        String?
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  utmContent      String?
  utmTerm         String?
  referrer        String?
  externalEventId String?
  clickedAt       DateTime  @default(now())
  idempotencyKey  String?
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@unique([workspaceId, externalEventId])
  @@index([workspaceId])
  @@index([workspaceId, campaignId])
  @@index([workspaceId, creatorId])
  @@index([workspaceId, platform])
}

model AffiliateConversion {
  id              String    @id @default(cuid())
  workspaceId     String
  clickId         String?
  amountCents     Int
  commissionCents Int?
  currency        String?
  status          String    @default("pending")
  convertedAt     DateTime  @default(now())
  payoutReference String?
  paidAt          DateTime?
  externalEventId String?
  idempotencyKey  String?
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@unique([workspaceId, externalEventId])
  @@index([workspaceId])
}

/**
 * Phase H: stored affiliate links. Tokens are public identifiers, never
 * secrets. Commission is derived from real conversion amounts only.
 */
model AffiliateLink {
  id             String    @id @default(cuid())
  workspaceId    String
  token          String
  campaignId     String?
  creatorId      String?
  productId      String?
  offerId        String
  destinationUrl String
  commissionBps  Int?
  disclosureText String?
  status         String    @default("active")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, token])
  @@index([workspaceId, campaignId])
}

/**
 * Phase H: explicit target accounts for publishing. No credential value is
 * stored here; credentials remain in the encrypted API Integration Center.
 */
model PublishingAccount {
  id          String    @id @default(cuid())
  workspaceId String
  platform    String
  accountKey  String
  displayName String?
  note        String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, platform, accountKey])
  @@index([workspaceId, platform])
}

/**
 * Phase H: one durable, timezone-aware publishing plan. An engine tick
 * enqueues at most one job per plan; approval and quality binding are checked
 * again at enqueue and at upload settlement.
 */
model PublishingSchedule {
  id               String    @id @default(cuid())
  workspaceId      String
  platform         String
  accountKey       String?
  entityType       String
  entityId         String
  idempotencyKey   String
  approvalId       String
  qualityReportId  String?
  checksum         String?
  options          Json?
  localTime        String
  timezone         String
  runAt            DateTime
  status           String    @default("PENDING")
  lastError        String?
  lastRunAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, runAt])
}

model Creator {
  id          String     @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  niches      String?
  platforms   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]

  @@index([workspaceId])
}

model Brand {
  id          String     @id @default(cuid())
  workspaceId String
  name        String
  guidelines  String?
  tone        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]

  @@index([workspaceId])
}

enum CampaignStatus {
  draft
  planned
  active
  paused
  completed
  cancelled
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  brandId     String?
  name        String
  goal        String?
  budgetCents Int?
  status      CampaignStatus @default(draft)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand       Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  creators    Creator[]
  tasks       Task[]

  @@index([workspaceId])
}

enum TaskStatus {
  open
  in_progress
  done
  cancelled
}

model Task {
  id          String     @id @default(cuid())
  workspaceId String
  campaignId  String?
  title       String
  description String?
  assignee    String?
  priority    String     @default("medium")
  status      TaskStatus @default(open)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign    Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

model AssetVersion {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  version     Int       @default(1)
  type        String?
  url         String?
  status      String    @default("draft")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Experiment {
  id          String              @id @default(cuid())
  workspaceId String
  name        String
  hypothesis  String?
  metric      String?
  status      String              @default("draft")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  variants    ExperimentVariant[]

  @@index([workspaceId])
}

model ExperimentVariant {
  id           String                  @id @default(cuid())
  experimentId String
  name         String
  description  String?
  createdAt    DateTime                @default(now())
  experiment   Experiment              @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  measurements ExperimentMeasurement[]
}

model ExperimentMeasurement {
  id         String            @id @default(cuid())
  variantId  String
  value      Float
  sampleSize Int               @default(0)
  measuredAt DateTime          @default(now())
  variant    ExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Insight {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  body        String
  source      String?
  confidence  Float     @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Approval {
  id          String    @id @default(cuid())
  workspaceId String
  entityType  String
  entityId    String
  status      String    @default("pending")
  requestedBy String?
  decidedBy   String?
  decidedAt   DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  reason      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

model KillSwitch {
  id          String    @id @default(cuid())
  workspaceId String
  active      Boolean   @default(false)
  reason      String?
  activatedBy String?
  activatedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId])
}

model SecurityEvent {
  id            String    @id @default(cuid())
  workspaceId   String
  type          String
  actor         String?
  agent         String?
  action        String?
  result        String
  details       String?
  correlationId String?
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model Incident {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  severity    String    @default("medium")
  status      String    @default("open")
  signature   String?
  details     String?
  /** Phase I.1: stable dedup key and structured evidence. */
  fingerprint String?
  kind        String?
  evidence    Json?
  diagnosis   Json?
  detectedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([workspaceId, status, detectedAt])
  @@index([workspaceId, kind])
}

model AgentDefinition {
  id           String      @id @default(cuid())
  workspaceId  String
  name         String
  role         String
  capabilities Json
  enabled      Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks        AgentTask[]

  @@index([workspaceId])
}

model AgentTask {
  id          String           @id @default(cuid())
  workspaceId String
  agentId     String?
  name        String
  status      String           @default("queued")
  input       Json?
  output      Json?
  error       String?
  dependsOn   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  startedAt   DateTime?
  finishedAt  DateTime?
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent       AgentDefinition? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
}

model ContentPost {
  id          String                @id @default(cuid())
  workspaceId String
  platform    String
  externalId  String
  title       String?
  url         String?
  publishedAt DateTime?
  format      String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshots   PerformanceSnapshot[]

  @@unique([workspaceId, platform, externalId])
  @@index([workspaceId, platform])
}

model PerformanceSnapshot {
  id           String      @id @default(cuid())
  workspaceId  String
  postId       String
  views        Int         @default(0)
  likes        Int         @default(0)
  comments     Int         @default(0)
  shares       Int         @default(0)
  watchTimeSec Float?
  capturedAt   DateTime    @default(now())
  post         ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, postId])
}

model OperationalPolicy {
  id          String    @id @default(cuid())
  workspaceId String
  key         String
  value       Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

model ContentLifecycleEvent {
  id          String    @id @default(cuid())
  workspaceId String
  entityType  String
  entityId    String
  fromStatus  String?
  toStatus    String
  actor       String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType, entityId])
}

model ReleaseCheck {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  status      String    @default("not_run")
  details     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

model InstallCheck {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  status      String    @default("not_run")
  details     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

model Department {
  id             String    @id @default(cuid())
  workspaceId    String
  key            String
  name           String
  description    String?
  parentKey      String?
  allowedTools   String[]
  maxConcurrency Int       @default(2)
  budgetLimit    Int       @default(1000)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model OrchestrationRun {
  id             String              @id @default(cuid())
  workspaceId    String
  goal           String
  requestedBy    String?
  idempotencyKey String?
  requestHash    String?
  status         String              @default("queued")
  strategy       Json?
  result         Json?
  error          String?
  budgetUnits    Int                 @default(100)
  spentUnits     Int                 @default(0)
  maxConcurrency Int                 @default(2)
  currentStage   String?
  leaseOwner     String?
  leaseToken     String?             @unique
  leaseExpiresAt DateTime?
  leaseEpoch     Int                 @default(0)
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tasks          OrchestrationTask[]
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, leaseExpiresAt])
}

model OrchestrationTask {
  id               String           @id @default(cuid())
  workspaceId      String
  runId            String
  parentTaskId     String?
  jobId            String?
  departmentKey    String
  agentType        String?
  action           String
  status           String           @default("queued")
  priority         Int              @default(0)
  input            Json?
  output           Json?
  error            String?
  requiresApproval Boolean          @default(false)
  approvalId       String?
  dependsOn        String[]
  estimatedUnits   Int              @default(1)
  actualUnits      Int              @default(0)
  attemptCount     Int              @default(0)
  maxAttempts      Int              @default(2)
  timeoutMs        Int              @default(30000)
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  run              OrchestrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  job              Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([runId, status])
  @@index([parentTaskId])
  @@index([jobId])
}

model DelegationRecord {
  id           String    @id @default(cuid())
  workspaceId  String
  runId        String?
  fromRole     String
  toDepartment String
  taskIds      String[]
  reason       String?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

/**
 * Phase F — API Integration Center.
 *
 * Secrets are stored only as AES-256-GCM ciphertext with a separately managed
 * master key. The AAD binds each blob to its workspace and provider, so a blob
 * cannot be moved to another owner. All four models are protected by forced
 * RLS; every access goes through `withWorkspaceTransaction`.
 */
model ApiCredential {
  id          String          @id @default(cuid())
  workspaceId String
  providerKey String
  kind        String          @default("API_KEY")
  ciphertext  String
  iv          String
  tag         String
  hint        String
  expiresAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connections ApiConnection[]

  @@unique([workspaceId, providerKey])
  @@index([workspaceId])
}

model ApiConnection {
  id                  String         @id @default(cuid())
  workspaceId         String
  providerKey         String
  status              String         @default("NOT_CONFIGURED")
  enabled             Boolean        @default(true)
  credentialId        String?
  credential          ApiCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastErrorCode       String?
  lastErrorCategory   String?
  consecutiveFailures Int            @default(0)
  circuitState        String         @default("CLOSED")
  cooldownUntil       DateTime?
  quota               Json?
  grantedScopes       String[]
  tokenExpiresAt      DateTime?
  connectedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, providerKey])
  @@index([workspaceId, providerKey])
}

model ApiIntegrationEvent {
  id            String    @id @default(cuid())
  workspaceId   String
  providerKey   String
  type          String
  actor         String?
  outcome       String
  errorCode     String?
  errorCategory String?
  details       Json?
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, providerKey, createdAt])
}

model OAuthAuthorization {
  id            String    @id @default(cuid())
  stateHash     String    @unique
  workspaceId   String
  providerKey   String
  userId        String
  codeChallenge String?
  redirectUri   String
  scopes        String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, providerKey])
}


model DiscoveryCandidate {
  workspaceId  String
  source       String
  externalId   String
  title        String
  channel      String?
  firstFoundAt DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, source, externalId])
  @@index([workspaceId, firstFoundAt])
}

model DiscoverySchedule {
  id              String    @id @default(cuid())
  workspaceId     String
  query           String
  intervalMinutes Int
  enabled         Boolean   @default(true)
  nextRunAt       DateTime
  lastRunAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, enabled, nextRunAt])
}

model MediaSource {
  id           String   @id @default(cuid())
  workspaceId  String
  kind         String   @default("UPLOAD")
  name         String
  mimeType     String
  sizeBytes    Int
  sha256       String
  storagePath  String
  sourceUrl    String?
  rightsStatus String   @default("UNKNOWN")
  licenseNote  String?
  ffprobeJson  Json?
  status       String   @default("READY")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, sha256])
  @@index([workspaceId, rightsStatus])
}

model ResearchReport {
  id           String   @id @default(cuid())
  workspaceId  String
  candidateId  String?
  title        String
  overall      Float?
  scoreJson    Json
  origin       String   @default("heuristic")
  createdAt    DateTime @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, candidateId])
}

model QualityReport {
  id           String   @id @default(cuid())
  workspaceId  String
  jobId        String?
  clipPath     String
  checksum     String?
  passed       Boolean  @default(false)
  checksJson   Json
  createdAt    DateTime @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, jobId])
}


model RecoveryRun {
  id          String   @id @default(cuid())
  workspaceId String
  incidentId  String
  status      String   @default("planned")
  plan        Json
  approvalId  String?
  result      Json?
  rollback    Json?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, incidentId])
  @@index([workspaceId, status])
}

model ImprovementTask {
  id            String   @id @default(cuid())
  workspaceId   String
  incidentId    String?
  title         String
  evidence      Json
  priorityScore Int      @default(0)
  risk          String   @default("low")
  effort        String   @default("small")
  status        String   @default("proposed")
  beforeJson    Json?
  afterJson     Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, priorityScore])
}

model SandboxRun {
  id           String   @id @default(cuid())
  workspaceId  String
  worktreePath String
  status       String   @default("created")
  patchJson    Json?
  reviewJson   Json?
  testsJson    Json?
  approvedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}
