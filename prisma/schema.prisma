generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  memberships  Membership[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  items     Item[]
  niches    Niche[]
  products  Product[]
  ideas     ContentIdea[]
  integrations Integration[]
  workflows   WorkflowDefinition[]
  workflowRuns WorkflowRun[]
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  id          String         @id @default(cuid())
  userId      String
  workspaceId String
  role        MembershipRole @default(MEMBER)
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([userId, workspaceId])
}

model Item {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
}

model Agent {
  id               String   @id @default(cuid())
  key              String   @unique
  name             String
  description      String?
  status           String   @default("ACTIVE")
  toolPermissions  String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  runs             AgentRun[]

  @@index([status])
}

model AgentRun {
  id          String    @id @default(cuid())
  agentKey    String
  agent       Agent?    @relation(fields: [agentKey], references: [key])
  workspaceId String?
  userId      String?
  status      String
  input       Json
  output      Json?
  error       String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  auditEvents AuditEvent[]

  @@index([agentKey])
  @@index([workspaceId])
  @@index([status])
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String?
  userId      String?
  runId       String?
  run         AgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  type        String
  actor       String?
  data        Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([type])
  @@index([runId])
}


model Niche {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  demandScore Int      @default(0)
  competition Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products    Product[]
  ideas       ContentIdea[]
  @@index([workspaceId])
}

model Product {
  id          String   @id @default(cuid())
  workspaceId String
  nicheId     String?
  name        String
  category    String?
  priceCents  Int?
  source      String?
  sourceUrl   String?
  fetchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  niche       Niche?    @relation(fields: [nicheId], references: [id], onDelete: SetNull)
  @@index([workspaceId])
}

model ContentIdea {
  id          String   @id @default(cuid())
  workspaceId String
  nicheId     String?
  productId   String?
  title       String
  hook        String?
  format      String?
  targetAudience String?
  cta         String?
  keywords    String?
  score       Int      @default(0)
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  niche       Niche?    @relation(fields: [nicheId], references: [id], onDelete: SetNull)
  @@index([workspaceId])
}


enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  UNAVAILABLE
  ERROR
}

model Integration {
  id          String            @id @default(cuid())
  workspaceId String
  provider    String
  status      IntegrationStatus @default(NOT_CONFIGURED)
  config      Json?
  lastError   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, provider])
  @@index([workspaceId])
}


enum WorkflowStatus {
  pending
  queued
  running
  waiting_for_approval
  succeeded
  failed
  cancelled
}

model WorkflowDefinition {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  steps       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs        WorkflowRun[]
  @@index([workspaceId])
}

model WorkflowRun {
  id          String         @id @default(cuid())
  workspaceId String
  definitionId String
  status      WorkflowStatus @default(pending)
  currentStep Int            @default(0)
  input       Json?
  result      Json?
  error       String?
  idempotencyKey String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  definition  WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  steps       WorkflowStepRun[]
  @@index([workspaceId])
  @@unique([workspaceId, idempotencyKey])
}

model WorkflowStepRun {
  id          String         @id @default(cuid())
  runId       String
  stepIndex   Int
  name        String
  status      WorkflowStatus @default(pending)
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime       @default(now())
  run         WorkflowRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([runId])
}
