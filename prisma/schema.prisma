generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  memberships  Membership[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  items     Item[]
  niches    Niche[]
  products  Product[]
  ideas     ContentIdea[]
  integrations Integration[]
  workflows   WorkflowDefinition[]
  workflowRuns WorkflowRun[]
  analyticsSnapshots AnalyticsSnapshot[]
  affiliateClicks AffiliateClick[]
  affiliateConversions AffiliateConversion[]
  creators Creator[]
  brands Brand[]
  campaigns Campaign[]
  tasks Task[]
  assets AssetVersion[]
  experiments Experiment[]
  insights Insight[]
  approvals Approval[]
  killSwitches KillSwitch[]
  securityEvents SecurityEvent[]
  incidents Incident[]
  agents AgentDefinition[]
  agentTasks AgentTask[]
  jobs Job[]
  contentPosts ContentPost[]
  performanceSnapshots PerformanceSnapshot[]
  policies OperationalPolicy[]
  lifecycleEvents ContentLifecycleEvent[]
  releaseChecks ReleaseCheck[]
  installChecks InstallCheck[]
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  id          String         @id @default(cuid())
  userId      String
  workspaceId String
  role        MembershipRole @default(MEMBER)
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([userId, workspaceId])
}

model Item {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
}

model Agent {
  id               String   @id @default(cuid())
  key              String   @unique
  name             String
  description      String?
  status           String   @default("ACTIVE")
  toolPermissions  String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  runs             AgentRun[]

  @@index([status])
}

model AgentRun {
  id          String    @id @default(cuid())
  agentKey    String
  agent       Agent?    @relation(fields: [agentKey], references: [key])
  workspaceId String?
  userId      String?
  status      String
  input       Json
  output      Json?
  error       String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  auditEvents AuditEvent[]

  @@index([agentKey])
  @@index([workspaceId])
  @@index([status])
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String?
  userId      String?
  runId       String?
  run         AgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  type        String
  actor       String?
  data        Json?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@index([type])
  @@index([runId])
}


model Niche {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  demandScore Int      @default(0)
  competition Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products    Product[]
  ideas       ContentIdea[]
  @@index([workspaceId])
}

model Product {
  id          String   @id @default(cuid())
  workspaceId String
  nicheId     String?
  name        String
  category    String?
  priceCents  Int?
  source      String?
  sourceUrl   String?
  fetchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  niche       Niche?    @relation(fields: [nicheId], references: [id], onDelete: SetNull)
  @@index([workspaceId])
}

model ContentIdea {
  id          String   @id @default(cuid())
  workspaceId String
  nicheId     String?
  productId   String?
  title       String
  hook        String?
  format      String?
  targetAudience String?
  cta         String?
  keywords    String?
  score       Int      @default(0)
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  niche       Niche?    @relation(fields: [nicheId], references: [id], onDelete: SetNull)
  @@index([workspaceId])
}


enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  UNAVAILABLE
  ERROR
}

model Integration {
  id          String            @id @default(cuid())
  workspaceId String
  provider    String
  status      IntegrationStatus @default(NOT_CONFIGURED)
  config      Json?
  lastError   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, provider])
  @@index([workspaceId])
}


enum WorkflowStatus {
  pending
  queued
  running
  waiting_for_approval
  succeeded
  failed
  cancelled
}

enum JobStatus {
  QUEUED
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  FAILED
  CANCELLED
  DEAD_LETTER
  WAITING_FOR_APPROVAL
}

enum JobType {
  WORKFLOW_RUN
  AGENT_TASK
}

model WorkflowDefinition {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  steps       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs        WorkflowRun[]
  @@index([workspaceId])
}

model WorkflowRun {
  id          String         @id @default(cuid())
  workspaceId String
  definitionId String
  status      WorkflowStatus @default(pending)
  currentStep Int            @default(0)
  input       Json?
  result      Json?
  error       String?
  idempotencyKey String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  definition  WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  steps       WorkflowStepRun[]
  @@index([workspaceId])
  @@unique([workspaceId, idempotencyKey])
}

model WorkflowStepRun {
  id          String         @id @default(cuid())
  runId       String
  stepIndex   Int
  name        String
  status      WorkflowStatus @default(pending)
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime       @default(now())
  run         WorkflowRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([runId])
}


model Job {
  id            String   @id @default(cuid())
  workspaceId  String
  type         JobType  @default(WORKFLOW_RUN)
  category     String?
  status       JobStatus @default(QUEUED)
  priority     Int      @default(0)
  payload      Json
  idempotencyKey String?
  attempts      Int      @default(0)
  maxAttempts   Int      @default(3)
  lastError     String?
  leaseId       String?
  leaseOwner    String?
  leaseExpiresAt DateTime?
  heartbeatAt   DateTime?
  runAt         DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  timeoutAt    DateTime?
  parentJobId  String?
  workflowRunId String?
  agentTaskId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, runAt])
  @@unique([workspaceId, idempotencyKey])
  @@index([workflowRunId])
}

model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  workspaceId String
  source      String
  metric      String
  value       Float
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, metric])
}

model AffiliateClick {
  id          String   @id @default(cuid())
  workspaceId String
  contentId   String?
  offerId     String?
  clickedAt   DateTime @default(now())
  idempotencyKey String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
}

model AffiliateConversion {
  id          String   @id @default(cuid())
  workspaceId String
  clickId     String?
  amountCents Int
  status      String   @default("pending")
  convertedAt DateTime @default(now())
  idempotencyKey String?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId])
}


model Creator {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  niches      String?
  platforms   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]
  @@index([workspaceId])
}

model Brand {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  guidelines  String?
  tone        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]
  @@index([workspaceId])
}

enum CampaignStatus {
  draft
  planned
  active
  paused
  completed
  cancelled
}

model Campaign {
  id          String         @id @default(cuid())
  workspaceId String
  brandId     String?
  name        String
  goal        String?
  budgetCents Int?
  status      CampaignStatus @default(draft)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand       Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  creators    Creator[]
  tasks       Task[]
  @@index([workspaceId])
}

enum TaskStatus {
  open
  in_progress
  done
  cancelled
}

model Task {
  id          String     @id @default(cuid())
  workspaceId String
  campaignId  String?
  title       String
  description String?
  assignee    String?
  priority    String     @default("medium")
  status      TaskStatus @default(open)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign    Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  @@index([workspaceId])
}

model AssetVersion {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  version     Int      @default(1)
  type        String?
  url         String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
}


model Experiment {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  hypothesis  String?
  metric      String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  variants    ExperimentVariant[]
  @@index([workspaceId])
}

model ExperimentVariant {
  id          String   @id @default(cuid())
  experimentId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  experiment  Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  measurements ExperimentMeasurement[]
}

model ExperimentMeasurement {
  id          String   @id @default(cuid())
  variantId   String
  value       Float
  sampleSize  Int      @default(0)
  measuredAt  DateTime @default(now())
  variant     ExperimentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Insight {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  body        String
  source      String?
  confidence  Float    @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId])
}


model Approval {
  id          String   @id @default(cuid())
  workspaceId String
  entityType  String
  entityId    String
  status      String   @default("pending")
  requestedBy String?
  decidedBy   String?
  decidedAt   DateTime?
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, status])
}


model KillSwitch {
  id          String   @id @default(cuid())
  workspaceId String
  active      Boolean  @default(false)
  reason      String?
  activatedBy String?
  activatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId])
}

model SecurityEvent {
  id          String   @id @default(cuid())
  workspaceId String
  type        String
  actor       String?
  agent       String?
  action      String?
  result      String
  details     String?
  correlationId String?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}


model Incident {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  severity    String   @default("medium")
  status      String   @default("open")
  signature   String?
  details     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  resolvedAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, status])
}


model AgentDefinition {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  role        String
  capabilities Json
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       AgentTask[]
  @@index([workspaceId])
}

model AgentTask {
  id          String   @id @default(cuid())
  workspaceId String
  agentId     String?
  name        String
  status      String   @default("queued")
  input       Json?
  output      Json?
  error       String?
  dependsOn   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  startedAt   DateTime?
  finishedAt  DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent       AgentDefinition? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  @@index([workspaceId, status])
}


model ContentPost {
  id          String   @id @default(cuid())
  workspaceId String
  platform    String
  externalId  String
  title       String?
  url         String?
  publishedAt DateTime?
  format      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  snapshots   PerformanceSnapshot[]
  @@unique([workspaceId, platform, externalId])
  @@index([workspaceId, platform])
}

model PerformanceSnapshot {
  id          String   @id @default(cuid())
  workspaceId String
  postId      String
  views       Int      @default(0)
  likes       Int      @default(0)
  comments    Int      @default(0)
  shares      Int      @default(0)
  watchTimeSec Float?
  capturedAt  DateTime @default(now())
  post        ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, postId])
}


model OperationalPolicy {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  value       Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, key])
}

model ContentLifecycleEvent {
  id          String   @id @default(cuid())
  workspaceId String
  entityType  String
  entityId    String
  fromStatus  String?
  toStatus    String
  actor       String?
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, entityType, entityId])
}


model ReleaseCheck {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  status      String   @default("not_run")
  details     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, status])
}


model InstallCheck {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  status      String   @default("not_run")
  details     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, status])
}
