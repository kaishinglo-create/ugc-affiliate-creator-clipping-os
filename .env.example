# PostgreSQL connection (required)
DATABASE_URL="postgresql://user:password@host:5432/ugc_os"

# JWT session secret, at least 32 characters (required in production)
SESSION_JWT_SECRET="replace-with-32-plus-random-bytes"

# development | production
APP_ENV=development

# Allowed CORS origin for the web UI
CORS_ORIGIN="http://localhost:5173"

# HTTP port (default 3000)
PORT=3000

# Ollama cloud API key (never commit a value here)
OLLAMA_API_KEY=

# Control-center operator token. Required when using .mece-control; use at least 32 random characters.
MECE_DASHBOARD_TOKEN=

# Fastify proxy trust mode. Defaults to false. Use "loopback" or "1" only behind trusted proxy/local loopback.
TRUST_PROXY=0

# Maximum Ollama requests per workspace per UTC day. Defaults to 100; 0 disables Ollama.
OLLAMA_MAX_DAILY_REQUESTS_PER_WORKSPACE=100

# Background execution engine: claims and runs due jobs. Set to "off" to run an API-only process.
AUTOMATION_ENGINE=on

# Engine poll interval in milliseconds (default 3000).
AUTOMATION_ENGINE_INTERVAL_MS=3000
