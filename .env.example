# PostgreSQL connection (required)
DATABASE_URL="postgresql://user:password@host:5432/ugc_os"

# JWT session secret, at least 32 characters (required in production)
SESSION_JWT_SECRET="replace-with-32-plus-random-bytes"

# development | production
APP_ENV=development

# Allowed CORS origin for the web UI
CORS_ORIGIN="http://localhost:5173"

# HTTP port (default 3000)
PORT=3000
