# PostgreSQL connection (required)
DATABASE_URL="postgresql://user:password@host:5432/ugc_os"

# JWT session secret, at least 32 characters (required in every environment; no dev fallback)
SESSION_JWT_SECRET="replace-with-32-plus-random-bytes"

# development | production
APP_ENV=development

# Allowed CORS origin for the web UI
CORS_ORIGIN="http://localhost:5173"

# HTTP port (default 3000)
PORT=3000

# Ollama cloud API key (never commit a value here)
OLLAMA_API_KEY=

# Ollama endpoint (default https://ollama.com)
OLLAMA_BASE_URL=https://ollama.com

# Default model for every AI agent; override per agent with OLLAMA_MODEL_<AGENT>
# e.g. OLLAMA_MODEL_RESEARCH / OLLAMA_MODEL_CREATIVE
OLLAMA_MODEL=Base 1-flash

# AI agent gateway: auto = use AI when configured, off = never, required = fail agent tasks when AI is not configured
AGENT_AI_MODE=auto

# Max AI agent requests per workspace per UTC day (defaults to OLLAMA_MAX_DAILY_REQUESTS_PER_WORKSPACE, then 100; 0 disables AI)
AI_MAX_DAILY_REQUESTS_PER_WORKSPACE=100

# Control-center operator token. Required when using .mece-control; use at least 32 random characters.
MECE_DASHBOARD_TOKEN=

# Fastify proxy trust mode, derived only from this variable. 0/empty/unknown = false (fail closed),
# "loopback" or a hop count = restricted trust, "true"/"1" = explicit trust of every proxy hop.
TRUST_PROXY=0

# Maximum Ollama requests per workspace per UTC day. Defaults to 100; 0 disables Ollama.
OLLAMA_MAX_DAILY_REQUESTS_PER_WORKSPACE=100

# Background execution engine: claims and runs due jobs. Set to "off" to run an API-only process.
AUTOMATION_ENGINE=on

# Engine poll interval in milliseconds (default 3000).
AUTOMATION_ENGINE_INTERVAL_MS=3000

# Optional absolute path to pilots/api-anything/smoke.mjs after installing the pilot dependencies.
DISCOVERY_MCP_CLIENT=

# Optional OpenCode HTTP port used by the MECE control center (default 4096).
# Set a free port when another compatible instance already owns 4096.
MECE_OPENCODE_PORT=4096
# Optional MECE control-center port (default 3031).
MECE_CONTROL_PORT=3031
# Optional explicit publishing live-adapter opt-in (1/true). Without it no provider HTTP call is made.
PUBLISHING_LIVE_ADAPTERS=0
# Optional TTL (hours, 1-720, default 24) for a publishing approval.
PUBLISHING_APPROVAL_TTL_HOURS=24
# Optional hard daily cap on publishing attempts per workspace (default 50).
PUBLISHING_MAX_DAILY_ATTEMPTS_PER_WORKSPACE=50
# Optional per-provider HMAC secret for signed affiliate webhooks; never commit a real value.
# AFFILIATE_WEBHOOK_SECRET_<PROVIDER>=

# ===== Kern & Datenbank =====
# Fallback für APP_ENV, Prisma-Logging; Default: —; optional
NODE_ENV=

# ===== KI & Provider =====
# optionale Variable
OLLAMA_MODEL_RESEARCH=
# optionale Variable
OLLAMA_MODEL_CREATIVE=

# ===== MECE & Controller =====
# Fallback-Port; Default: —; optional
OPENCODE_PORT=
# MECE-Child-Env; Default: ephemer generiert; optional
OPENCODE_SERVER_PASSWORD=
# Fallback für Basic Auth; Default: —; optional
OPENCODE_PASSWORD=
# Watchdog und Doctor; Default: —; optional
CONTROLLER_STATUS_FILE=
# Autonomer Controller; Default: 480000; optional
CONTROLLER_AGENT_TIMEOUT_MS=480000
# Autonomer Controller; Default: 480000; optional
CONTROLLER_FULL_TEST_TIMEOUT_MS=480000
# Watchdog-Ressourcengate; Default: 256; optional
WATCHDOG_MIN_FREE_MEMORY_MB=256
# Watchdog-Ressourcengate; Default: 256; optional
WATCHDOG_MIN_CGROUP_MEMORY_MB=256
# Watchdog-Ressourcengate; Default: 1; optional
WATCHDOG_MIN_DISK_GB=1
# Watchdog-Ressourcengate; Default: 2; optional
WATCHDOG_MAX_LOAD_MULTIPLIER=2
# Watchdog-Entscheidung; Default: 60; optional
WATCHDOG_HEARTBEAT_MIN_AGE_SECONDS=60
# Watchdog-Nachlauf; Default: 0; optional
WATCHDOG_JOURNAL_BEFORE=0
# Watchdog-Ausführung; Default: 900; optional
WATCHDOG_ONCE_TIMEOUT_SECONDS=900
# Watchdog-Scheduler; Default: 300; optional
WATCHDOG_SCHEDULE_INTERVAL_SECONDS=300
# Watchdog-Scheduler; Default: 1; optional
WATCHDOG_SCHEDULE_TICKS=1
# Watchdog-Scheduler; Default: .run/controller-watchdog-schedule.jsonl; optional
WATCHDOG_SCHEDULE_LOG_FILE=.run/controller-watchdog-schedule.jsonl
# Scheduler-Override; Default: scripts/controller-watchdog.sh; optional
WATCHDOG_SCRIPT=scripts/controller-watchdog.sh
# Scheduler-Override; Default: bash; optional
WATCHDOG_RUNNER=bash
# Watchdog/Scheduler/Doctor; Default: node; optional
NODE_BIN=node
# Watchdog/Scheduler/Pilot; Default: /tmp/opencode (Skripte); optional
TMPDIR=
# MECE-Runtime-Test; Default: 3131; optional
MECE_TEST_CONTROL_PORT=3131
# MECE-Runtime-Test; Default: 4097; optional
MECE_TEST_OPENCODE_PORT=4097

# ===== Discovery & MCP =====
# MCP-Kindprozess/netzwerk; Default: —; optional
HTTP_PROXY=
# MCP-Kindprozess/netzwerk; Default: —; optional
HTTPS_PROXY=
# MCP-Kindprozess/netzwerk; Default: —; optional
NO_PROXY=
# MCP-Kindprozess; Default: —; optional
NODE_USE_ENV_PROXY=
# MCP-Kindprozess; Default: —; optional
NODE_EXTRA_CA_CERTS=
# api-anything/host; Default: mkdtemp; intern
API_ANYTHING_HOME=
# api-anything/host; Default: 1; intern
API_ANYTHING_LOCAL_ONLY=1
# Externe API-Anything-Registry; Default: —; optional
API_ANYTHING_KEY=
# Externe Registry-Auth; Default: —; optional
API_ANYTHING_TOKEN=
# Externe Discovery-Quellen; Default: —; optional
API_ANYTHING_REGISTRY=

# ===== Browser Runtime =====
# HTTP-Browser-Adapter; Default: —; optional
BROWSER_RUNTIME_URL=
# Auth des Browser-Adapters; Default: —; optional
BROWSER_RUNTIME_TOKEN=
# Browser-Host; Default: 3200; optional
BROWSER_RUNTIME_PORT=3200
# Browser-Host; Default: 127.0.0.1; optional
BROWSER_RUNTIME_HOST=127.0.0.1
# Playwright-Executable; Default: —; optional
BROWSER_EXECUTABLE_PATH=
# Playwright-Fallback; Default: —; optional
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# ===== Medien =====
# Clipping/Audio-Extraktion; Default: ffmpeg (PATH); optional
FFMPEG_BIN=
# Medienanalyse; Default: ffprobe (PATH); optional
FFPROBE_BIN=
# Video-Export; Default: libx264; optional
FFMPEG_VIDEO_CODEC=libx264
# Binary-Sicherung; Default: 120000; optional
FFMPEG_TIMEOUT_MS=120000
# Transkription; Default: whisper (PATH); optional
WHISPER_BIN=
# Transkription; Default: —; optional
WHISPER_MODEL=
# DE-Transkription; Default: —; optional
WHISPER_MODEL_MULTILINGUAL=
# Ressourcenbegrenzung; Default: 1; optional
WHISPER_THREADS=1
# Ressourcenbegrenzung; Default: 2; optional
WHISPER_THREADS_MAX=2
# Binary-Sicherung; Default: 300000; optional
WHISPER_TIMEOUT_MS=300000
# Upload-/Job-Verzeichnisse; Default: OS-TMP; optional
UGC_MEDIA_TMP_DIR=
# Upload-Guard; Default: 8388608; optional
UGC_MEDIA_MAX_UPLOAD_BYTES=8388608
# verify:media; Default: /tmp/opencode/ugc-media-verify; optional
MEDIA_VERIFY_DIR=/tmp/opencode/ugc-media-verify
# verify:media; Default: $HOME/.local/share/ugc-media/whisper/samples/en-test-sentence-cc0.wav; optional
WHISPER_SAMPLE=
# verify:media (DE-Fall); Default: $HOME/.local/share/ugc-media/whisper/samples/de-deutschland-cc0.flac; optional
WHISPER_SAMPLE_DE=

# ===== Publishing & Integrationen =====
# YouTube-Upload; Default: —; optional publishing
YOUTUBE_CLIENT_ID=
# YouTube-Token-Refresh; Default: —; optional publishing
YOUTUBE_CLIENT_SECRET=
# YouTube-Token-Refresh; Default: —; optional publishing
YOUTUBE_REFRESH_TOKEN=
# TikTok-Content-Posting; Default: —; optional publishing
TIKTOK_CLIENT_KEY=
# TikTok-Token-Refresh; Default: —; optional publishing
TIKTOK_CLIENT_SECRET=
# TikTok-Token-Refresh; Default: —; optional publishing
TIKTOK_REFRESH_TOKEN=
# Instagram-Graph-Publishing; Default: —; optional publishing
INSTAGRAM_ACCESS_TOKEN=
# Media-Container; Default: —; optional publishing
INSTAGRAM_USER_ID=
# Token-Refresh; Default: —; optional publishing
INSTAGRAM_APP_ID=
# Token-Refresh; Default: —; optional publishing
INSTAGRAM_APP_SECRET=
# Phase F: getrennter AES-256-GCM Master-Key für API-Integration-Center-Credentials.
# Erzeugen mit: openssl rand -base64 32
# Ohne gültigen Key werden Credentials abgelehnt (fail-closed); kein statischer Fallback.
API_INTEGRATIONS_MASTER_KEY=
# Alternativ: Pfad zu einer Datei mit genau 32 base64-kodierten Bytes.
API_INTEGRATIONS_MASTER_KEY_FILE=
# Phase F: absolute public base URL for registered OAuth redirect URIs, e.g.
# https://ugc.example.com. Required outside loopback development; the exact
# provider redirect URI is /api/api-integrations/oauth/<provider>/callback.
# Without it, local loopback requests derive the origin from the request host.
API_INTEGRATIONS_OAUTH_BASE_URL=

# Nur Präsenzanzeige; Default: —; optional
YAPS_API_KEY=
# Nur Präsenzanzeige; Default: —; optional
CLIPPINGMINI_API_KEY=
# Nur Präsenzanzeige; Default: —; optional
KLAP_API_KEY=
# Nur Präsenzanzeige; Default: —; optional
OPUSCLIP_API_KEY=

# ===== Diagnose & Verifikation =====
# Services Doctor; Default: .env; optional
SERVICES_DOTENV_FILE=.env
# Services Doctor; Default: 2000; optional
SERVICES_DOCTOR_TIMEOUT_MS=2000
# Services Doctor; Default: —; optional
SERVICES_DOCTOR_PORTS=
# Services Doctor; Default: —; optional
SERVICES_DOCTOR_DB_CHECK=
